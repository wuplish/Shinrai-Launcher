                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="TEK TIKLA 1.21.11 (SODIUM + FABRIC + VANILLA) &amp; 1.12.2 HAZIRLAYICI" FontSize="14" FontWeight="ExtraBold" Foreground="#A78BFA"/>
                                            <TextBlock Text="1.21.11, Fabric Loader, Sodium, Lithium, FerriteCore, EntityCulling ve 1.12.2 sürümlerini tüm yüksek FPS ayarlarıyla otomatik indirip kurar." FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Content="Şimdi Kur / Onar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" Click="AutoSetupTargetVersionsBtn_Click"/>
                                    </DockPanel>
                                </Border>

                                <!-- SCHOOL SIDE: DOWNLOAD FROM GITHUB RELEASES OR LOCAL ZIP -->
                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="OKULDA KURULUM: GITHUB DEPOSU (wuplish/Shinrai-Launcher)" FontSize="13.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GitHubRepoTextBox" Style="{StaticResource DarkTextBox}"/>
                                            <Button Grid.Column="2" Content="Release Listele" Style="{StaticResource SecondaryButton}" Click="FetchReleaseAssetsBtn_Click"/>
                                            <ComboBox Grid.Column="4" x:Name="ReleaseAssetsComboBox" Height="36"/>
                                            <Button Grid.Column="6" Content="Paketi Kur" Style="{StaticResource PrimaryButton}" Click="DownloadSelectedAssetBtn_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="DirectZipUrlTextBox" Style="{StaticResource DarkTextBox}"/>
                                            <Button Grid.Column="2" Content="Linkten İndir" Style="{StaticResource SecondaryButton}" Click="DownloadDirectUrlBtn_Click"/>
                                            <Button Grid.Column="4" Content="USB / .zip Kur..." Style="{StaticResource SecondaryButton}" Click="InstallLocalZipBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- HOME SIDE: PREPARE PORTABLE GAME & CREATE GITHUB RELEASE ZIP -->
                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="EVDE PAKETLEME &amp; PORTABLE JAVA EKLEME" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="SystemVersionsComboBox" Height="36"/>
                                            <Button Grid.Column="2" Content="Sistemdekileri Tara" Style="{StaticResource SecondaryButton}" Click="ScanSystemVersionsBtn_Click"/>
                                            <Button Grid.Column="4" Content="Portable Klasöre Aktar" Style="{StaticResource SecondaryButton}" Click="ImportSystemVersionBtn_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="VanillaDownloadComboBox" Height="36" SelectedIndex="0">
                                                <ComboBoxItem Content="1.21.11"/>
                                                <ComboBoxItem Content="1.12.2"/>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="Sürüm İndir" Style="{StaticResource SecondaryButton}" Click="DownloadVanillaAtHomeBtn_Click"/>
                                            <ComboBox Grid.Column="4" x:Name="PortableJavaMajorComboBox" Height="36" SelectedIndex="0">
                                                <ComboBoxItem Content="Java 21" Tag="21"/>
                                                <ComboBoxItem Content="Java 8" Tag="8"/>
                                            </ComboBox>
                                            <Button Grid.Column="6" Content="Java İndir" Style="{StaticResource SecondaryButton}" Click="DownloadPortableJavaBtn_Click"/>
                                            <Button Grid.Column="8" Content="Release ZIP" Style="{StaticResource PrimaryButton}" Click="CreateReleaseBundleBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- ==================== COL 2: RIGHT SATELLITE SIDEBAR (100% CUSTOM VECTOR EMBLEMS + DARK COMBOBOX) ==================== -->
                <Border Grid.Column="2" Background="#0C0D14" BorderBrush="#181B29" BorderThickness="1,0,0,0" Padding="14,14,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top 5-Emblem Quick Bar (Custom Vector SVG Badges — Zero Emojis!) -->
                        <Border Grid.Row="0" Background="#141724" BorderBrush="#22263A" BorderThickness="1" CornerRadius="10" Padding="6,6" Margin="0,0,0,14">
                            <UniformGrid Columns="5">
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="0" Margin="2,0" BorderThickness="0" Background="#251B42" ToolTip="1.21.11 Sodium Seç" Click="QuickSelect12111Sodium_Click">
                                    <Path Data="{StaticResource GeoRocket}" Stroke="#C4B5FD" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="0" Margin="2,0" BorderThickness="0" Background="Transparent" ToolTip="1.12.2 Classic PvP Seç" Click="QuickSelect1122_Click">
                                    <Path Data="{StaticResource GeoSwords}" Stroke="#FBBF24" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="0" Margin="2,0" BorderThickness="0" Background="Transparent" ToolTip="1.21.11 Vanilla Seç" Click="QuickSelect12111Vanilla_Click">
                                    <Path Data="{StaticResource GeoDiamond}" Stroke="#38BDF8" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="0" Margin="2,0" BorderThickness="0" Background="Transparent" ToolTip="Bedrock Edition Seç" Click="SelectBedrockEditionBtn_Click">
                                    <Path Data="{StaticResource GeoCube}" Stroke="#F472B6" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="0" Margin="2,0" BorderThickness="0" Background="Transparent" ToolTip="Mod Menüsünü Aç" Click="OpenFpsSettingsFromHero_Click">
                                    <Path Data="{StaticResource GeoPuzzle}" Stroke="#A78BFA" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                            </UniformGrid>
                        </Border>

                        <!-- Active Version & Telemetry Selector Box (With Custom Dark ComboBox!) -->
                        <Border Grid.Row="1" Background="#131622" BorderBrush="#22263A" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Java Selector -->
                                <StackPanel x:Name="JavaEditionCard">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="ACTIVE PROFILE" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource SecondaryButton}" Width="26" Height="24" Padding="0" HorizontalAlignment="Right" Click="RefreshVersionsBtn_Click" ToolTip="Sürümleri Yenile">
                                            <Path Data="{StaticResource GeoRefresh}" Stroke="#CBD5E1" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </DockPanel>
                                    <ComboBox x:Name="JavaVersionComboBox" Height="36" FontSize="11.5" FontWeight="SemiBold" SelectionChanged="JavaVersionComboBox_SelectionChanged" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="VersionStatusHintText" Text="" FontSize="10.5" Foreground="#C4B5FD" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Border Background="#0B0D14" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock x:Name="JavaRuntimeStatusText" Text="Java Runtime: Hazır" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ActiveRamStatusText" Text="Ayrılan Bellek: 4096 MB" FontSize="10" Foreground="#8E96AA" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Bedrock Selector -->
                                <StackPanel x:Name="BedrockEditionCard" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="BEDROCK EDITION" FontSize="11" FontWeight="Bold" Foreground="#EC4899" VerticalAlignment="Center"/>
                                        <Button Content="Java" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" HorizontalAlignment="Right" Click="SelectJavaEditionBtn_Click"/>
                                    </DockPanel>
                                    <TextBlock x:Name="BedrockStatusText" Text="Kontrol ediliyor..." FontSize="10.5" Foreground="#F9A8D4" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="Portable Bedrock Exe Seç..." Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BrowseBedrockExeBtn_Click"/>
                                    <Button Content="Kurulum Sekmesine Git" Style="{StaticResource SecondaryButton}" Click="GoToGitHubTab_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Friends / School LAN Satellite Section -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="2,0,2,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="School LAN " FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="(Satellite)" FontSize="12.5" Foreground="#64748B"/>
                                </StackPanel>
                                <TextBlock Text="Open LAN" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E96AA" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenLanTabFromSidebar_Click"/>
                            </DockPanel>

                            <!-- Satellite Info Card -->
                            <Border Grid.Row="1" Background="#131622" BorderBrush="#22263A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoGlobe}" Stroke="#64748B" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Yerel IP:" FontSize="10.5" Foreground="#8E96AA"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CardLocalIpText" Text="192.168.x.x" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoShirt}" Stroke="#64748B" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Aktif Skin:" FontSize="10.5" Foreground="#8E96AA"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CardSkinSummaryText" Text="Crimson_Samurai.png" FontSize="10.5" FontWeight="SemiBold" Foreground="#C4B5FD" HorizontalAlignment="Right" MaxWidth="145" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <Button Content="Sınıf LAN Sunucularını Aç" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,6" Click="OpenLanTabFromSidebar_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Iconic Lunar Vector Crescent Emblem Watermark in Lower Sidebar -->
                            <Border Grid.Row="2" Width="106" Height="106" CornerRadius="53" BorderBrush="#191D2E" BorderThickness="2"
                                    Background="#0E1018" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoMoon}" Stroke="#333B59" StrokeThickness="2.2" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="SHINRAI" FontSize="9.5" FontWeight="Bold" Foreground="#3B4363" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bottom Promo Bar -->
                        <Border Grid.Row="3" Background="#131622" BorderBrush="#22263A" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoBolt}" Fill="#A855F7" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="100% Portable" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="GitHub Sync" Style="{StaticResource PrimaryButton}" Padding="11,4" FontSize="10.5" HorizontalAlignment="Right" Click="GoToGitHubTab_Click"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== ROW 2: COLLAPSIBLE CONSOLE LOG DRAWER ==================== -->
            <Border x:Name="ConsoleDrawer" Grid.Row="2" Visibility="Collapsed" Height="135" Background="#06070B" BorderBrush="#1E2235" BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="SHINRAI ENGINE CONSOLE" FontSize="10" FontWeight="Bold" Foreground="#A78BFA"/>
                        <Button Content="Temizle" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10" HorizontalAlignment="Right" Click="ClearConsoleBtn_Click"/>
                    </DockPanel>
                    <TextBox x:Name="ConsoleTextBox" Grid.Row="1" Background="Transparent" Foreground="#C4B5FD" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- ==================== ROW 3: SLEEK BOTTOM TELEMETRY BAR ==================== -->
            <Border Grid.Row="3" Background="#08090E" BorderBrush="#181B29" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="0,0,7,0"/>
                        <TextBlock x:Name="BottomEditionBadge" Text="1.21.11-SODIUM • LUNAR" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1"/>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StatusActionText" Text="Hazır — 1.21.11 (Sodium/Fabric) &amp; 1.12.2 yerel motor aktif." FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Column="2" x:Name="MainProgressBar" Height="5" Minimum="0" Maximum="100" Value="100" Background="#151824" Foreground="#8B5CF6" BorderThickness="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" x:Name="StatusPercentText" Text="100%" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Padding="9,3" Margin="0,0,6,0" Click="OpenGameDataFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoFolder}" Stroke="#CBD5E1" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="game_data" FontSize="10.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ToggleConsoleBtn" Style="{StaticResource SecondaryButton}" Padding="9,3" Click="ToggleConsoleBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoTerminal}" Stroke="#CBD5E1" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Konsol" FontSize="10.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
