                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                    <Button Grid.Row="2" Tag="{Binding Id}" Click="LunarModCardToggle_Click" Cursor="Hand" Height="32" BorderThickness="0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="FontFamily" Value="{StaticResource PoppinsFont}"/>
                                                                <Setter Property="Background" Value="#7C3AED"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="Content" Value="ENABLED"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Background" Value="#222638"/>
                                                                        <Setter Property="Foreground" Value="#8E96AA"/>
                                                                        <Setter Property="Content" Value="DISABLED"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- RAM & JVM Card -->
                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="BELLEK (RAM) &amp; JVM MOTOR AYARLARI" FontSize="13.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="125"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="RamSlider" Minimum="1024" Maximum="12288" TickFrequency="512" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RamSlider_ValueChanged"/>
                                            <Border Grid.Column="1" Background="#0B0D14" BorderBrush="#2D334D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="12,0,0,0">
                                                <TextBlock x:Name="RamValueLabel" Text="4096 MB" FontSize="13" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="JvmPresetComboBox" Height="36" SelectionChanged="JvmPresetComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Okul PC / Düşük Sistem Modu (Düşük Takılma, Intel HD Dostu G1GC)"/>
                                                <ComboBoxItem Content="Aikar's Flags Yüksek Performans (Lunar Sodium / OptiFine Önerilen)"/>
                                                <ComboBoxItem Content="ZGC Ultra Düşük Gecikme (Java 21+ / 1.21.11 İçin)"/>
                                                <ComboBoxItem Content="Özel JVM Argümanları"/>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="Özel Java (javaw.exe) Seç..." Style="{StaticResource SecondaryButton}" Click="BrowseJavaExeBtn_Click"/>
                                        </Grid>

                                        <TextBox x:Name="CustomJvmArgsTextBox" Style="{StaticResource DarkTextBox}" TextChanged="CustomJvmArgsTextBox_TextChanged" Margin="0,0,0,10"/>

                                        <WrapPanel>
                                            <CheckBox x:Name="OfflineIsolationCheckBox" Content="Tamamen Offline İzolasyon (Mojang sunucu sorgularını 127.0.0.1'e yönlendir)" Foreground="White" FontSize="11.5" Margin="0,0,20,4" Checked="FpsCheckBoxes_Changed" Unchecked="FpsCheckBoxes_Changed"/>
                                            <CheckBox x:Name="AutoFpsOptionsCheckBox" Content="Oyun Başlarken Lunar FPS Ayarlarını Otomatik Uygula" Foreground="White" FontSize="11.5" Checked="FpsCheckBoxes_Changed" Unchecked="FpsCheckBoxes_Changed"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Local Mods List -->
                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="YÜKLÜ .JAR MODLARI ('game_data/.minecraft/mods')" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="+ Mod (.jar) Ekle" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0" Click="AddModJarBtn_Click"/>
                                                <Button Content="Klasörü Aç" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="OpenModsFolderBtn_Click"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ListBox x:Name="ModsListBox" Height="130" Background="#0B0D14" BorderBrush="#222638" Foreground="White">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="290"/>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding CategoryBadge}" Foreground="#A78BFA" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Content="Aç / Kapat" Style="{StaticResource SecondaryButton}" Padding="10,3" Tag="{Binding FullPath}" Click="ToggleModItemBtn_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

