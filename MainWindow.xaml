<Window x:Class="ShinraiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shinrai Client — Lunar Launchpad"
        Width="1220" Height="770"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <!-- Outer Rounded Borderless Lunar Client Frame -->
    <Border Background="{StaticResource BgDeepBrush}" BorderBrush="#1F2335" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: AUTHENTIC LUNAR TOP BAR ==================== -->
            <Border Grid.Row="0" Background="#08090E" BorderBrush="#181B29" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Lunar Moon Icon + "Shinrai Client ▾" + Arrows + "Launchpad" Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                    <GradientStop Color="#06B6D4" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🌙" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Shinrai Client" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Text="▾" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="5,1,12,0"/>

                        <TextBlock Text="‹" FontSize="15" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,-2,10,0"/>
                        <TextBlock Text="›" FontSize="15" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,-2,12,0"/>

                        <TextBlock x:Name="TopBreadcrumbText" Text="Launchpad" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Coins/FPS Pill + SFX Pill + Player Account Pill + Instances Pill + Win Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- FPS Boost Badge Pill -->
                        <Border Background="#161824" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,5,0"/>
                                <TextBlock Text="FPS++" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio / Equalizer Pill -->
                        <Border Background="#161824" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="🎵 ılıl ▾" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA"/>
                        </Border>

                        <!-- Account Pill: [Pixel Head] wuplish ● ▾ -->
                        <Border Background="#161824" BorderBrush="#2B3048" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="15" Height="15" CornerRadius="3" Background="#312E81" Margin="0,0,6,0">
                                    <TextBlock Text="👾" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox x:Name="UsernameTextBox" Width="76" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                         BorderThickness="0" CaretBrush="#8B5CF6" MaxLength="16" VerticalContentAlignment="Center"
                                         TextChanged="UsernameTextBox_TextChanged" ToolTip="Offline (Cracked) Kullanıcı Adını Değiştir"/>
                                <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="4,0,4,0"/>
                                <TextBlock Text="▾" FontSize="9" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="UuidPreviewText" Visibility="Collapsed"/>

                        <!-- Instances Running Pill -->
                        <Border Background="#161824" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="11" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="InstancesRunningText" Text="0 Instances Running ↗" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                        </Border>

                        <!-- Window Controls -->
                        <Button Content="—" Style="{StaticResource WinCtrlButton}" Click="MinimizeWindow_Click" ToolTip="Küçült"/>
                        <Button Content="▢" Style="{StaticResource WinCtrlButton}" Click="MaximizeWindow_Click" ToolTip="Tam Ekran"/>
                        <Button Content="✕" Style="{StaticResource WinCtrlButton}" Click="CloseWindow_Click" ToolTip="Kapat"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: 3-COLUMN LUNAR CLIENT BODY ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="295"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== COL 0: LEFT SLIM ICON RAIL ==================== -->
                <Border Grid.Column="0" Background="#090A0F" BorderBrush="#181B29" BorderThickness="0,0,1,0" Padding="0,12,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main Navigation Icons -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <RadioButton x:Name="NavPlayBtn" Content="🚀" Style="{StaticResource LunarRailNavButton}" IsChecked="True" Checked="NavButton_Checked" ToolTip="Launchpad (Ana Ekran)"/>
                            <RadioButton x:Name="NavFpsBtn" Content="🧩" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="Lunar Mod Menu &amp; FPS Ayarları"/>
                            <RadioButton x:Name="NavLanBtn" Content="🌍" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="Okul LAN Sunucuları &amp; Relay"/>
                            <RadioButton x:Name="NavSkinBtn" Content="👕" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="Offline Skin &amp; Pelerin Stüdyosu"/>
                            <RadioButton x:Name="NavGithubBtn" Content="☁️" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="GitHub Bulut &amp; Portable Kurulum"/>
                        </StackPanel>

                        <!-- Bottom Quick Actions (+ and Gear, just like Lunar Client) -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                            <Button Content="⊕" Style="{StaticResource SecondaryButton}" Width="38" Height="36" Padding="0" FontSize="16" Margin="0,0,0,8"
                                    ToolTip="1.21.11 Sodium + 1.12.2 Sürümlerini Otomatik Onar / Kur" Click="AutoSetupTargetVersionsBtn_Click"/>
                            <Button Content="⚙" Style="{StaticResource SecondaryButton}" Width="38" Height="36" Padding="0" FontSize="15"
                                    ToolTip="Motor Konsolunu Aç / Kapat" Click="ToggleConsoleBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== COL 1: CENTER LAUNCHPAD CANVAS ==================== -->
                <Border Grid.Column="1" Background="{StaticResource BgCanvasBrush}" Padding="22,16,20,14">
                    <Grid>

                        <!-- ==================== VIEW 1: LUNAR LAUNCHPAD ==================== -->
                        <ScrollViewer x:Name="ViewPlay" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Top Greeting Row: "Welcome Back Astronaut, wuplish ●" & "● 100% Local Offline" -->
                                <DockPanel Margin="2,0,2,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Welcome Back Astronaut, " FontSize="15.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <Border Width="20" Height="20" CornerRadius="4" Background="#2E1065" BorderBrush="#7C3AED" BorderThickness="1" Margin="4,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="🥷" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="GreetingUsernameText" Text="wuplish" FontSize="16" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="#A855F7" Margin="7,1,5,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="▾" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#38BDF8" BlurRadius="8" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="100% Local" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text=" Offline Ready" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ==================== HERO SPACE LAUNCHPAD BANNER ==================== -->
                                <Border Height="236" CornerRadius="16" Margin="0,0,0,20" BorderBrush="#262B44" BorderThickness="1" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#07080F" Offset="0.0"/>
                                            <GradientStop Color="#121026" Offset="0.45"/>
                                            <GradientStop Color="#1B1136" Offset="0.75"/>
                                            <GradientStop Color="#091326" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>
                                        <!-- Decorative Starfield & Cosmic Nebula Glows -->
                                        <Canvas IsHitTestVisible="False">
                                            <!-- Subtle Nebula Orbs -->
                                            <Ellipse Width="340" Height="220" Canvas.Left="210" Canvas.Top="10" Opacity="0.22">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="260" Height="200" Canvas.Left="460" Canvas.Top="25" Opacity="0.18">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!-- Stars -->
                                            <Ellipse Width="2.5" Height="2.5" Fill="#E2E8F0" Canvas.Left="60" Canvas.Top="35" Opacity="0.7"/>
                                            <Ellipse Width="2" Height="2" Fill="#A78BFA" Canvas.Left="190" Canvas.Top="52" Opacity="0.8"/>
                                            <Ellipse Width="3" Height="3" Fill="#38BDF8" Canvas.Left="280" Canvas.Top="28" Opacity="0.6"/>
                                            <Ellipse Width="2" Height="2" Fill="#F8FAFC" Canvas.Left="440" Canvas.Top="40" Opacity="0.5"/>
                                            <Ellipse Width="2.5" Height="2.5" Fill="#C084FC" Canvas.Left="580" Canvas.Top="32" Opacity="0.7"/>
                                            <Ellipse Width="2" Height="2" Fill="#E2E8F0" Canvas.Left="680" Canvas.Top="68" Opacity="0.5"/>
                                            <Ellipse Width="3" Height="3" Fill="#818CF8" Canvas.Left="330" Canvas.Top="195" Opacity="0.6"/>
                                            <Ellipse Width="2" Height="2" Fill="#38BDF8" Canvas.Left="510" Canvas.Top="185" Opacity="0.7"/>
                                        </Canvas>

                                        <!-- Left 3D-Style Voxel Astronaut Illustration (Floating Tilt) -->
                                        <Grid Width="155" Height="175" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,12,0,0" IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="-11" CenterX="75" CenterY="85"/>
                                            </Grid.RenderTransform>
                                            <!-- Floating Cyber Block Behind Astronaut -->
                                            <Border Width="42" Height="42" CornerRadius="6" Background="#3B0764" BorderBrush="#9333EA" BorderThickness="1.5"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-18,-10,0,0">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="22"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <!-- Voxel Astronaut Helmet -->
                                            <Border Width="76" Height="72" CornerRadius="10" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                                                <!-- Glowing Cyber Visor -->
                                                <Border Width="54" Height="38" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#1E1B4B" Offset="0.0"/>
                                                            <GradientStop Color="#4C1D95" Offset="0.6"/>
                                                            <GradientStop Color="#0284C7" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="9" Height="9" Background="#38BDF8" CornerRadius="2" Margin="0,0,12,0"/>
                                                        <Border Width="9" Height="9" Background="#38BDF8" CornerRadius="2"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <!-- Voxel Torso & Arms -->
                                            <Border Width="62" Height="56" CornerRadius="8" Background="#CBD5E1" BorderBrush="#64748B" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
                                                <Border Width="32" Height="22" CornerRadius="4" Background="#5B21B6" BorderBrush="#A78BFA" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="22" Height="48" CornerRadius="6" Background="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,78,0,0"/>
                                            <Border Width="22" Height="48" CornerRadius="6" Background="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,14,0"/>
                                            <!-- Voxel Legs -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,132,0,0">
                                                <Border Width="25" Height="34" CornerRadius="5" Background="#64748B" Margin="0,0,5,0"/>
                                                <Border Width="25" Height="34" CornerRadius="5" Background="#475569"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Right 3D-Style Voxel Rocket Illustration (Floating Tilt) -->
                                        <Grid Width="130" Height="175" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,44,0" IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="-24" CenterX="65" CenterY="85"/>
                                            </Grid.RenderTransform>
                                            <!-- Rocket Nose Cone -->
                                            <Border Width="34" Height="26" CornerRadius="8,8,2,2" Background="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                            <!-- Rocket Fuselage -->
                                            <Border Width="54" Height="82" CornerRadius="8" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#0EA5E9" BorderBrush="#38BDF8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"/>
                                            </Border>
                                            <!-- Rocket Fins -->
                                            <Border Width="18" Height="36" CornerRadius="4" Background="#4F46E5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,82,0,0"/>
                                            <Border Width="18" Height="36" CornerRadius="4" Background="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,82,22,0"/>
                                            <!-- Glowing Plasma ExhaustParticles -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,116,0,0">
                                                <Border Width="26" Height="18" CornerRadius="4" Background="#F59E0B"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <Border Width="9" Height="9" CornerRadius="2" Background="#FBBF24" Margin="2"/>
                                                    <Border Width="11" Height="11" CornerRadius="3" Background="#F97316" Margin="2"/>
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="#38BDF8" Margin="2"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ==================== DEAD-CENTER ICONIC LAUNCH BUTTON ==================== -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button x:Name="LaunchGameBtn" Style="{StaticResource HeroLaunchButton}" Width="300" Height="72" Click="LaunchGameBtn_Click">
                                                <Grid Width="256">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LaunchBtnTitleText" Text="LAUNCH GAME" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                            <TextBlock Text="🌙 " FontSize="11" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="LaunchBtnSubtitleText" Text="Shinrai 1.21.11 with 🚀 Sodium" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0E7FF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="▾" FontSize="12" Foreground="#C4B5FD" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                        <!-- Bottom-Right Corner Gear Button inside Hero Banner (Just like Lunar Screenshot!) -->
                                        <Button Content="⚙" Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" FontSize="15"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                                                ToolTip="FPS, RAM ve Mod Ayarlarını Aç" Click="OpenFpsSettingsFromHero_Click"/>
                                    </Grid>
                                </Border>

                                <!-- ==================== SECTION HEADER: FEATURED PROFILES (LIKE "Latest News" IN LUNAR) ==================== -->
                                <DockPanel Margin="2,0,2,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Launchpad Profiles " FontSize="15" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="(4 ready)" FontSize="14.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Content="⚡ Auto-Setup / Repair All ▾" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                            HorizontalAlignment="Right" Click="AutoSetupTargetVersionsBtn_Click"/>
                                </DockPanel>

                                <!-- ==================== 2x2 VISUAL ARTWORK PROFILE CARDS (LUNAR NEWS CARD STYLE) ==================== -->
                                <UniformGrid Columns="2">

                                    <!-- CARD 1: 1.21.11 SODIUM + FABRIC -->
                                    <Border CornerRadius="14" Height="164" Margin="0,0,8,14" BorderBrush="#312E81" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonUp="QuickSelect12111Sodium_Click">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#161233" Offset="0.0"/>
                                                <GradientStop Color="#2E1065" Offset="0.55"/>
                                                <GradientStop Color="#0F172A" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Padding="18,14">
                                            <!-- Top-Left Glowing Violet Status Orb -->
                                            <Ellipse Width="12" Height="12" Fill="#A855F7" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <StackPanel VerticalAlignment="Center" Margin="6,6,0,0">
                                                <Border Background="#3B0764" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="5" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <TextBlock Text="🚀 RECOMMENDED • +300% FPS" FontSize="9.5" FontWeight="Black" Foreground="#DDD6FE"/>
                                                </Border>
                                                <TextBlock Text="SODIUM 1.21.11" FontSize="25" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="Fabric 0.19.5 • Lithium • FerriteCore • EntityCulling" FontSize="11.5" Foreground="#C4B5FD" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Bottom Sub-Icons & Right Arrow Circle -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6,0,0,0">
                                                <Border Background="#1E1B4B" CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                                                    <TextBlock Text="☕ Java 21 Portable" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC"/>
                                                </Border>
                                                <Border Background="#1E1B4B" CornerRadius="5" Padding="7,3">
                                                    <TextBlock Text="☀️ Fullbright" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>

                                            <Button Content="➔" Style="{StaticResource PrimaryButton}" Width="30" Height="30" Padding="0" FontSize="13"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="QuickSelect12111Sodium_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- CARD 2: CLASSIC PVP 1.12.2 / 1.12.12 (SPOOKY/CRIMSON COLLECTION STYLE) -->
                                    <Border CornerRadius="14" Height="164" Margin="8,0,0,14" BorderBrush="#7F1D1D" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonUp="QuickSelect1122_Click">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A0A10" Offset="0.0"/>
                                                <GradientStop Color="#450A0A" Offset="0.55"/>
                                                <GradientStop Color="#1F1209" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Padding="18,14">
                                            <!-- Top-Left Glowing Amber/Crimson Status Orb -->
                                            <Ellipse Width="12" Height="12" Fill="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#F59E0B" BlurRadius="10" ShadowDepth="0"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <StackPanel VerticalAlignment="Center" Margin="6,6,0,0">
                                                <Border Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <TextBlock Text="⚔️ COMPETITIVE PVP EDITION" FontSize="9.5" FontWeight="Black" Foreground="#FDE68A"/>
                                                </Border>
                                                <TextBlock Text="CLASSIC 1.12.2" FontSize="25" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="1.12.12 PvP Engine • Zero Input Lag • HitReg &amp; Fast Math" FontSize="11.5" Foreground="#FECACA" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6,0,0,0">
                                                <Border Background="#2D0C0E" CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                                                    <TextBlock Text="☕ Java 8 Portable" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5"/>
                                                </Border>
                                                <Border Background="#2D0C0E" CornerRadius="5" Padding="7,3">
                                                    <TextBlock Text="⚡ 260+ FPS" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                                </Border>
                                            </StackPanel>

                                            <Button Content="➔" Style="{StaticResource PrimaryButton}" Width="30" Height="30" Padding="0" FontSize="13"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="QuickSelect1122_Click"/>
                                        </Grid>
                                    </Border>

