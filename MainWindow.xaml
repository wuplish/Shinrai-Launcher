                                                <ComboBoxItem Content="Java 8" Tag="8"/>
                                            </ComboBox>
                                            <Button Grid.Column="6" Content="☕ Java İndir" Style="{StaticResource SecondaryButton}" Click="DownloadPortableJavaBtn_Click"/>
                                            <Button Grid.Column="8" Content="📦 Release ZIP" Style="{StaticResource PrimaryButton}" Click="CreateReleaseBundleBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- ==================== COL 2: RIGHT SATELLITE SIDEBAR (AUTHENTIC LUNAR RIGHT PANEL) ==================== -->
                <Border Grid.Column="2" Background="#0C0D14" BorderBrush="#181B29" BorderThickness="1,0,0,0" Padding="14,14,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top 5-Emblem Quick Bar (Matching H / Crown / CG / W / E Bar in Lunar Screenshot!) -->
                        <Border Grid.Row="0" Background="#141724" BorderBrush="#22263A" BorderThickness="1" CornerRadius="10" Padding="6,6" Margin="0,0,0,14">
                            <UniformGrid Columns="5">
                                <Button Content="🚀" Style="{StaticResource SecondaryButton}" Padding="0,5" Margin="2,0" BorderThickness="0" Background="#251B42" Foreground="#C4B5FD" ToolTip="1.21.11 Sodium Seç" Click="QuickSelect12111Sodium_Click"/>
                                <Button Content="⚔️" Style="{StaticResource SecondaryButton}" Padding="0,5" Margin="2,0" BorderThickness="0" Background="Transparent" Foreground="#FBBF24" ToolTip="1.12.2 Classic PvP Seç" Click="QuickSelect1122_Click"/>
                                <Button Content="💎" Style="{StaticResource SecondaryButton}" Padding="0,5" Margin="2,0" BorderThickness="0" Background="Transparent" Foreground="#38BDF8" ToolTip="1.21.11 Vanilla Seç" Click="QuickSelect12111Vanilla_Click"/>
                                <Button Content="🪨" Style="{StaticResource SecondaryButton}" Padding="0,5" Margin="2,0" BorderThickness="0" Background="Transparent" Foreground="#F472B6" ToolTip="Bedrock Edition Seç" Click="SelectBedrockEditionBtn_Click"/>
                                <Button Content="🧩" Style="{StaticResource SecondaryButton}" Padding="0,5" Margin="2,0" BorderThickness="0" Background="Transparent" Foreground="#A78BFA" ToolTip="Mod Menüsünü Aç" Click="OpenFpsSettingsFromHero_Click"/>
                            </UniformGrid>
                        </Border>

                        <!-- Active Version & Telemetry Selector Box -->
                        <Border Grid.Row="1" Background="#131622" BorderBrush="#22263A" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Java Selector -->
                                <StackPanel x:Name="JavaEditionCard">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="ACTIVE PROFILE" FontSize="10.5" FontWeight="Black" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                        <Button Content="🔄" Style="{StaticResource SecondaryButton}" Padding="7,2" FontSize="10.5" HorizontalAlignment="Right" Click="RefreshVersionsBtn_Click" ToolTip="Sürümleri Yenile"/>
                                    </DockPanel>
                                    <ComboBox x:Name="JavaVersionComboBox" Height="34" FontSize="12.5" FontWeight="Bold" SelectionChanged="JavaVersionComboBox_SelectionChanged" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="VersionStatusHintText" Text="" FontSize="11" Foreground="#C4B5FD" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Border Background="#0B0D14" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock x:Name="JavaRuntimeStatusText" Text="Java Runtime: Hazır" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ActiveRamStatusText" Text="Ayrılan Bellek: 4096 MB" FontSize="10.5" Foreground="#8E96AA" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Bedrock Selector -->
                                <StackPanel x:Name="BedrockEditionCard" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="🪨 BEDROCK EDITION" FontSize="11" FontWeight="Black" Foreground="#EC4899" VerticalAlignment="Center"/>
                                        <Button Content="☕ Java" Style="{StaticResource SecondaryButton}" Padding="7,2" FontSize="10.5" HorizontalAlignment="Right" Click="SelectJavaEditionBtn_Click"/>
                                    </DockPanel>
                                    <TextBlock x:Name="BedrockStatusText" Text="Kontrol ediliyor..." FontSize="11" Foreground="#F9A8D4" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="📂 Portable Bedrock Exe Seç..." Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BrowseBedrockExeBtn_Click"/>
                                    <Button Content="☁️ Kurulum Sekmesine Git" Style="{StaticResource SecondaryButton}" Click="GoToGitHubTab_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Friends / School LAN Satellite Section (Matching "Friends (0 online)" + Lunar Moon Watermark!) -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="2,0,2,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="School LAN " FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="(Satellite)" FontSize="13" Foreground="#64748B"/>
                                </StackPanel>
                                <TextBlock Text="Open LAN ↗" FontSize="11" Foreground="#8E96AA" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenLanTabFromSidebar_Click"/>
                            </DockPanel>

                            <!-- Satellite Info Card -->
                            <Border Grid.Row="1" Background="#131622" BorderBrush="#22263A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="🌐 Yerel IP:" FontSize="11" Foreground="#8E96AA"/>
                                        <TextBlock x:Name="CardLocalIpText" Text="192.168.x.x" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="👕 Aktif Skin:" FontSize="11" Foreground="#8E96AA"/>
                                        <TextBlock x:Name="CardSkinSummaryText" Text="Shinrai_Shadow_Ninja.png" FontSize="11" FontWeight="SemiBold" Foreground="#C4B5FD" HorizontalAlignment="Right" MaxWidth="145" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <Button Content="📡 Sınıf LAN Sunucularını Aç" Style="{StaticResource SecondaryButton}" FontSize="11.5" Padding="10,6" Click="OpenLanTabFromSidebar_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Iconic Lunar Crescent Emblem Watermark in Lower Sidebar -->
                            <Border Grid.Row="2" Width="108" Height="108" CornerRadius="54" BorderBrush="#1A1E2E" BorderThickness="2"
                                    Background="#0E1018" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🌙" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="SHINRAI" FontSize="9.5" FontWeight="Black" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bottom Promo Bar (Matching "Remove ads with Lunar+! [Subscribe]" at bottom-right of screenshot!) -->
                        <Border Grid.Row="3" Background="#131622" BorderBrush="#22263A" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " FontSize="12" Foreground="#A855F7"/>
                                    <TextBlock Text="100% Portable" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                                </StackPanel>
                                <Button Content="🚀 GitHub Sync" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="10.5" HorizontalAlignment="Right" Click="GoToGitHubTab_Click"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== ROW 2: COLLAPSIBLE CONSOLE LOG DRAWER ==================== -->
            <Border x:Name="ConsoleDrawer" Grid.Row="2" Visibility="Collapsed" Height="135" Background="#06070B" BorderBrush="#1E2235" BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="SHINRAI ENGINE CONSOLE" FontSize="10" FontWeight="Bold" Foreground="#A78BFA"/>
                        <Button Content="Temizle" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10" HorizontalAlignment="Right" Click="ClearConsoleBtn_Click"/>
                    </DockPanel>
                    <TextBox x:Name="ConsoleTextBox" Grid.Row="1" Background="Transparent" Foreground="#C4B5FD" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- ==================== ROW 3: SLEEK BOTTOM TELEMETRY BAR ==================== -->
            <Border Grid.Row="3" Background="#08090E" BorderBrush="#181B29" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="0,0,7,0"/>
                        <TextBlock x:Name="BottomEditionBadge" Text="1.21.11-SODIUM • LUNAR" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1"/>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StatusActionText" Text="Hazır — 1.21.11 (Sodium/Fabric) &amp; 1.12.2 yerel motor aktif." FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Column="2" x:Name="MainProgressBar" Height="5" Minimum="0" Maximum="100" Value="100" Background="#151824" Foreground="#8B5CF6" BorderThickness="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" x:Name="StatusPercentText" Text="100%" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📂 game_data" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" Margin="0,0,6,0" Click="OpenGameDataFolder_Click"/>
                        <Button x:Name="ToggleConsoleBtn" Content="📟 Konsol" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" Click="ToggleConsoleBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
