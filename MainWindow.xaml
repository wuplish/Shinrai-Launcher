<Window x:Class="ShinraiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shinrai Client — Lunar Launchpad"
        Width="1230" Height="775"
        MinWidth="1050" MinHeight="690"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PoppinsFont}">

    <!-- Outer Rounded Borderless Lunar Client Frame -->
    <Border Background="{StaticResource BgDeepBrush}" BorderBrush="#1F2335" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: AUTHENTIC LUNAR TOP BAR ==================== -->
            <Border Grid.Row="0" Background="#08090E" BorderBrush="#181B29" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Custom Vector Crescent Moon Logo + "Shinrai Client" + Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Margin="0,0,9,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                    <GradientStop Color="#4F46E5" Offset="0.55"/>
                                    <GradientStop Color="#06B6D4" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource GeoMoon}" Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Shinrai Client" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource GeoChevronDown}" Stroke="#64748B" StrokeThickness="1.8" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="6,1,14,0"/>

                        <TextBlock Text="‹" FontSize="15" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,-2,10,0"/>
                        <TextBlock Text="›" FontSize="15" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,-2,12,0"/>

                        <TextBlock x:Name="TopBreadcrumbText" Text="Launchpad" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Custom Vector FPS Badge + Audio Equalizer Pill + Custom Avatar Account Pill + Instances Pill + Win Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- FPS Boost Badge Pill -->
                        <Border Background="#151824" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="11" Padding="10,3" Margin="0,0,7,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoBolt}" Fill="#FBBF24" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="FPS++" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio Equalizer Pill (Custom Vector Bars) -->
                        <Border Background="#151824" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="11" Padding="10,4" Margin="0,0,7,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="2.5" Height="7" CornerRadius="1" Background="#A78BFA" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                <Border Width="2.5" Height="11" CornerRadius="1" Background="#38BDF8" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                <Border Width="2.5" Height="6" CornerRadius="1" Background="#A78BFA" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                <Border Width="2.5" Height="9" CornerRadius="1" Background="#C084FC" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                                <Path Data="{StaticResource GeoChevronDown}" Stroke="#64748B" StrokeThickness="1.6" Width="7" Height="4" Stretch="Uniform" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Account Pill: [Custom Pixel Avatar] wuplish ● -->
                        <Border Background="#151824" BorderBrush="#2D324A" BorderThickness="1" CornerRadius="11" Padding="8,3" Margin="0,0,7,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Custom Embedded Pixel Avatar Head -->
                                <Border Width="16" Height="16" CornerRadius="4" Background="#31105A" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,0,7,0">
                                    <Grid Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="3" Height="3" Background="#38BDF8" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="3" Height="3" Background="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="UsernameTextBox" Width="78" Background="Transparent" Foreground="White" FontFamily="{StaticResource PoppinsFont}"
                                         FontWeight="Bold" FontSize="11.5" BorderThickness="0" CaretBrush="#8B5CF6" MaxLength="16" VerticalContentAlignment="Center"
                                         TextChanged="UsernameTextBox_TextChanged" ToolTip="Offline (Cracked) Kullanıcı Adını Değiştir"/>
                                <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="4,0,5,0"/>
                                <Path Data="{StaticResource GeoChevronDown}" Stroke="#64748B" StrokeThickness="1.6" Width="7" Height="4" Stretch="Uniform" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="UuidPreviewText" Visibility="Collapsed"/>

                        <!-- Instances Running Pill -->
                        <Border Background="#151824" BorderBrush="#262A3E" BorderThickness="1" CornerRadius="11" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="InstancesRunningText" Text="0 Instances Running" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                        </Border>

                        <!-- Window Controls -->
                        <Button Content="—" Style="{StaticResource WinCtrlButton}" Click="MinimizeWindow_Click" ToolTip="Küçült"/>
                        <Button Content="▢" Style="{StaticResource WinCtrlButton}" Click="MaximizeWindow_Click" ToolTip="Tam Ekran"/>
                        <Button Content="✕" Style="{StaticResource WinCtrlButton}" Click="CloseWindow_Click" ToolTip="Kapat"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: 3-COLUMN LUNAR CLIENT BODY ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== COL 0: LEFT SLIM ICON RAIL (100% CUSTOM VECTOR ICONS) ==================== -->
                <Border Grid.Column="0" Background="#090A0F" BorderBrush="#181B29" BorderThickness="0,0,1,0" Padding="0,12,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main Navigation Vector Icons -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <RadioButton x:Name="NavPlayBtn" Style="{StaticResource LunarRailNavButton}" IsChecked="True" Checked="NavButton_Checked" ToolTip="Launchpad (Ana Ekran)">
                                <Path Data="{StaticResource GeoRocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                            <RadioButton x:Name="NavFpsBtn" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="Lunar Mod Menu &amp; FPS Engine">
                                <Path Data="{StaticResource GeoPuzzle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                            <RadioButton x:Name="NavLanBtn" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="Okul LAN Sunucuları &amp; Relay">
                                <Path Data="{StaticResource GeoGlobe}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                            <RadioButton x:Name="NavSkinBtn" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="Offline Skin &amp; Pelerin Stüdyosu">
                                <Path Data="{StaticResource GeoShirt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                            <RadioButton x:Name="NavGithubBtn" Style="{StaticResource LunarRailNavButton}" Checked="NavButton_Checked" ToolTip="GitHub Bulut &amp; Portable Kurulum">
                                <Path Data="{StaticResource GeoCloud}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Quick Actions (+ and Gear Vector Buttons) -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Width="38" Height="36" Padding="0" Margin="0,0,0,8"
                                    ToolTip="1.21.11 Sodium + 1.12.2 Sürümlerini Otomatik Onar / Kur" Click="AutoSetupTargetVersionsBtn_Click">
                                <Path Data="{StaticResource GeoPlus}" Stroke="#CBD5E1" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Width="38" Height="36" Padding="0"
                                    ToolTip="Motor Konsolunu Aç / Kapat" Click="ToggleConsoleBtn_Click">
                                <Path Data="{StaticResource GeoGear}" Stroke="#CBD5E1" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== COL 1: CENTER LAUNCHPAD CANVAS ==================== -->
                <Border Grid.Column="1" Background="{StaticResource BgCanvasBrush}" Padding="22,16,20,14">
                    <Grid>

                        <!-- ==================== VIEW 1: LUNAR LAUNCHPAD ==================== -->
                        <ScrollViewer x:Name="ViewPlay" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Top Greeting Row: "Welcome Back Astronaut, [Custom Cyber Badge] wuplish ●" -->
                                <DockPanel Margin="2,0,2,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Welcome Back Astronaut, " FontSize="15" FontWeight="Medium" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <!-- Custom Multi-Layer Voxel Helmet Badge (No Emoji!) -->
                                        <Border Width="22" Height="22" CornerRadius="5" Background="#2E1065" BorderBrush="#8B5CF6" BorderThickness="1.2" Margin="4,0,7,0" VerticalAlignment="Center">
                                            <Border Width="14" Height="9" CornerRadius="2" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="3" Height="3" Background="#38BDF8" Margin="0,0,2,0"/>
                                                    <Border Width="3" Height="3" Background="#38BDF8"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <TextBlock x:Name="GreetingUsernameText" Text="wuplish" FontSize="15.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="#A855F7" Margin="7,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Path Data="{StaticResource GeoChevronDown}" Stroke="#64748B" StrokeThickness="1.6" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#38BDF8" BlurRadius="8" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="100% Local" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text=" Offline Ready" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ==================== HERO SPACE LAUNCHPAD BANNER ==================== -->
                                <Border Height="232" CornerRadius="16" Margin="0,0,0,18" BorderBrush="#262B44" BorderThickness="1" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#07080F" Offset="0.0"/>
                                            <GradientStop Color="#121026" Offset="0.45"/>
                                            <GradientStop Color="#1B1136" Offset="0.75"/>
                                            <GradientStop Color="#091326" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>
                                        <!-- Decorative Starfield & Cosmic Nebula Glows -->
                                        <Canvas IsHitTestVisible="False">
                                            <Ellipse Width="340" Height="220" Canvas.Left="210" Canvas.Top="10" Opacity="0.22">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="260" Height="200" Canvas.Left="460" Canvas.Top="25" Opacity="0.18">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="2.5" Height="2.5" Fill="#E2E8F0" Canvas.Left="60" Canvas.Top="35" Opacity="0.7"/>
                                            <Ellipse Width="2" Height="2" Fill="#A78BFA" Canvas.Left="190" Canvas.Top="52" Opacity="0.8"/>
                                            <Ellipse Width="3" Height="3" Fill="#38BDF8" Canvas.Left="280" Canvas.Top="28" Opacity="0.6"/>
                                            <Ellipse Width="2" Height="2" Fill="#F8FAFC" Canvas.Left="440" Canvas.Top="40" Opacity="0.5"/>
                                            <Ellipse Width="2.5" Height="2.5" Fill="#C084FC" Canvas.Left="580" Canvas.Top="32" Opacity="0.7"/>
                                            <Ellipse Width="2" Height="2" Fill="#E2E8F0" Canvas.Left="680" Canvas.Top="68" Opacity="0.5"/>
                                            <Ellipse Width="3" Height="3" Fill="#818CF8" Canvas.Left="330" Canvas.Top="195" Opacity="0.6"/>
                                            <Ellipse Width="2" Height="2" Fill="#38BDF8" Canvas.Left="510" Canvas.Top="185" Opacity="0.7"/>
                                        </Canvas>

                                        <!-- Left 3D-Style Voxel Astronaut Illustration -->
                                        <Grid Width="155" Height="175" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,12,0,0" IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="-11" CenterX="75" CenterY="85"/>
                                            </Grid.RenderTransform>
                                            <Border Width="42" Height="42" CornerRadius="6" Background="#3B0764" BorderBrush="#9333EA" BorderThickness="1.5"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-18,-10,0,0">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="22"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border Width="76" Height="72" CornerRadius="10" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                                                <Border Width="54" Height="38" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#1E1B4B" Offset="0.0"/>
                                                            <GradientStop Color="#4C1D95" Offset="0.6"/>
                                                            <GradientStop Color="#0284C7" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="9" Height="9" Background="#38BDF8" CornerRadius="2" Margin="0,0,12,0"/>
                                                        <Border Width="9" Height="9" Background="#38BDF8" CornerRadius="2"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <Border Width="62" Height="56" CornerRadius="8" Background="#CBD5E1" BorderBrush="#64748B" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
                                                <Border Width="32" Height="22" CornerRadius="4" Background="#5B21B6" BorderBrush="#A78BFA" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="22" Height="48" CornerRadius="6" Background="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,78,0,0"/>
                                            <Border Width="22" Height="48" CornerRadius="6" Background="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,14,0"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,132,0,0">
                                                <Border Width="25" Height="34" CornerRadius="5" Background="#64748B" Margin="0,0,5,0"/>
                                                <Border Width="25" Height="34" CornerRadius="5" Background="#475569"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Right 3D-Style Voxel Rocket Illustration -->
                                        <Grid Width="130" Height="175" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,44,0" IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="-24" CenterX="65" CenterY="85"/>
                                            </Grid.RenderTransform>
                                            <Border Width="34" Height="26" CornerRadius="8,8,2,2" Background="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                            <Border Width="54" Height="82" CornerRadius="8" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#0EA5E9" BorderBrush="#38BDF8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"/>
                                            </Border>
                                            <Border Width="18" Height="36" CornerRadius="4" Background="#4F46E5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,82,0,0"/>
                                            <Border Width="18" Height="36" CornerRadius="4" Background="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,82,22,0"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,116,0,0">
                                                <Border Width="26" Height="18" CornerRadius="4" Background="#F59E0B"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <Border Width="9" Height="9" CornerRadius="2" Background="#FBBF24" Margin="2"/>
                                                    <Border Width="11" Height="11" CornerRadius="3" Background="#F97316" Margin="2"/>
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="#38BDF8" Margin="2"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ==================== DEAD-CENTER ICONIC LAUNCH BUTTON (CUSTOM VECTOR BADGES + POPPINS) ==================== -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button x:Name="LaunchGameBtn" Style="{StaticResource HeroLaunchButton}" Width="312" Height="74" Click="LaunchGameBtn_Click">
                                                <Grid Width="268">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LaunchBtnTitleText" Text="LAUNCH GAME" FontSize="20" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                            <Path Data="{StaticResource GeoMoon}" Fill="#C4B5FD" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="LaunchBtnSubtitleText" Text="Shinrai 1.21.11 with Fabric / Sodium" FontSize="11" FontWeight="SemiBold" Foreground="#E0E7FF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Path Grid.Column="1" Data="{StaticResource GeoChevronDown}" Stroke="#C4B5FD" StrokeThickness="1.8" Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                        <!-- Bottom-Right Corner Vector Gear Button inside Hero Banner -->
                                        <Button Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                                                ToolTip="FPS, RAM ve Mod Ayarlarını Aç" Click="OpenFpsSettingsFromHero_Click">
                                            <Path Data="{StaticResource GeoGear}" Stroke="#CBD5E1" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ==================== SECTION HEADER: FEATURED PROFILES ==================== -->
                                <DockPanel Margin="2,0,2,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Launchpad Profiles " FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="(4 ready)" FontSize="14" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Padding="11,5" HorizontalAlignment="Right" Click="AutoSetupTargetVersionsBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoBolt}" Fill="#A78BFA" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Auto-Setup / Repair All" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <!-- ==================== 2x2 VISUAL ARTWORK PROFILE CARDS (CUSTOM VECTOR BADGES + POPPINS) ==================== -->
                                <UniformGrid Columns="2">

                                    <!-- CARD 1: 1.21.11 SODIUM + FABRIC -->
                                    <Border CornerRadius="14" Height="162" Margin="0,0,8,14" BorderBrush="#3730A3" BorderThickness="1.5" Cursor="Hand"
                                            MouseLeftButtonUp="QuickSelect12111Sodium_Click">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#161233" Offset="0.0"/>
                                                <GradientStop Color="#2E1065" Offset="0.55"/>
                                                <GradientStop Color="#0F172A" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Margin="18,14">
                                            <Ellipse Width="11" Height="11" Fill="#A855F7" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <StackPanel VerticalAlignment="Center" Margin="4,6,0,0">
                                                <Border Background="#3B0764" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="5" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoRocket}" Stroke="#DDD6FE" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="RECOMMENDED • +300% FPS" FontSize="9.5" FontWeight="Bold" Foreground="#DDD6FE"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="SODIUM 1.21.11" FontSize="23" FontWeight="ExtraBold" Foreground="White"/>
                                                <TextBlock Text="Fabric 0.19.5 • Lithium • FerriteCore • EntityCulling" FontSize="11" Foreground="#C4B5FD" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4,0,0,0">
                                                <Border Background="#1E1B4B" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
