                        <!-- ==================== VIEW 2: LUNAR MOD MENU & FPS SETTINGS (CUSTOM VECTOR BADGES) ==================== -->
                        <ScrollViewer x:Name="ViewFps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="LUNAR CLIENT MOD MENU &amp; FPS OPTIMIZER" FontSize="17" FontWeight="ExtraBold" Foreground="White"/>
                                        <TextBlock Text="Modları tek tıkla ENABLED / DISABLED yapın; ayarlar otomatik olarak Sodium, OptiFine ve Vanilla profillerine işlenir." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Content="Tüm FPS Ayarlarını Şimdi Uygula" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ApplyFpsOptionsNow_Click"/>
                                </DockPanel>

                                <!-- Lunar 3-Column Mod Toggle Grid with Custom Embedded Vector SVG Icons -->
                                <ItemsControl x:Name="LunarModsItemsControl" Margin="0,0,0,18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
