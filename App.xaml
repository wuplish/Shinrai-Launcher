<Application x:Class="ShinraiLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Embedded Poppins Font Family (Compiled directly into EXE) -->
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Assets/Fonts/#Poppins</FontFamily>

        <!-- Cosmic Obsidian & Electric Violet Palette -->
        <SolidColorBrush x:Key="BgDeepBrush" Color="#090A0F"/>
        <SolidColorBrush x:Key="BgCanvasBrush" Color="#0E1017"/>
        <SolidColorBrush x:Key="BgPanelBrush" Color="#11131C"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#151824"/>
        <SolidColorBrush x:Key="BgInputBrush" Color="#0B0D14"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#222638"/>
        <SolidColorBrush x:Key="LunarEmeraldBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="LunarEmeraldHoverBrush" Color="#A78BFA"/>
        <SolidColorBrush x:Key="LunarVioletBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentCrimsonBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentCrimsonHoverBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentPinkBrush" Color="#EC4899"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E96AA"/>

        <!-- ==================== EMBEDDED CUSTOM VECTOR ICON GEOMETRIES (ZERO EMOJIS!) ==================== -->
